<?xml version="1.0"?>
<!DOCTYPE workflow
[ 
  <!ENTITY HOMEBASE "/work/DEV/yongzuo/ChinaBeijing">
  <!ENTITY NPS_FIX "&HOMEBASE;/nps_fix">
  <!ENTITY GSI_FIX "&HOMEBASE;/gsi_fix">
  <!ENTITY NMMB_FIX "&HOMEBASE;/nmmb_fix">
  <!ENTITY rocoto "&HOMEBASE;/rocoto">
  <!ENTITY LOG_DIR "&HOMEBASE;/logs">
  <!ENTITY OBS_DIR "&HOMEBASE;/obs/20150602">
  <!ENTITY GFS_DIR "&HOMEBASE;/gfs/20150602">
  <!ENTITY boco_DIR "&HOMEBASE;/boco/2015060212">

  <!ENTITY NMMBPROC "184">
  <!ENTITY INPES "16">
  <!ENTITY JPES "11">
  <!ENTITY WRITEGROUPS "2">
  <!ENTITY WRITETASKS "4">

  <!ENTITY QUEUE "dev_q">
  <!ENTITY GSIPROC "48">
  <!ENTITY UPPPROC "4">
  <!ENTITY SINGLEPROC "1">

]>

<workflow realtime="F" scheduler="torque" cyclelifespan="0:04:00:00">

  <log><cyclestr>&LOG_DIR;/workflow_@Y@m@d@H.log</cyclestr></log>

  <cycledef group="group1">201506021200 201506021200 01:00:00</cycledef>  

  <task name="NPS" maxtries="1">
    <command>&rocoto;/run_nps.bash</command>
    <nodes>&SINGLEPROC;:ppn=1</nodes>
    <queue>&QUEUE;</queue>
    <walltime>01:00:00</walltime>
    <jobname><cyclestr>nps@Y@m@d@H</cyclestr></jobname>
    <join><cyclestr>&LOG_DIR;/nps_@Y@m@d@H.log</cyclestr></join>

    <envar>
      <name>HOMEBASE</name>
      <value>&HOMEBASE;</value>
    </envar>
    <envar>
      <name>rocoto</name>
      <value>&rocoto;</value>
    </envar>
    <envar>
      <name>NPS_FIX</name>
      <value>&NPS_FIX;</value>
    </envar>
    <envar>
      <name>boco_DIR</name>
      <value>&boco_DIR;</value>
    </envar>
    <envar>
      <name>GFS_DIR</name>
      <value>&GFS_DIR;</value>
    </envar>
    <envar>
      <name>NPS_DIR</name>
      <value><cyclestr>&HOMEBASE;/@Y@m@d@H/nps</cyclestr></value>
    </envar>
    <envar>
      <name>START_TIME</name>
      <value><cyclestr>@s</cyclestr></value>
    </envar>
    <envar>
      <name>ANAL_TIME</name>
      <value><cyclestr>@Y@m@d@H</cyclestr></value>
    </envar>
    <envar>
      <name>ST_md</name>
      <value><cyclestr>@m@d</cyclestr></value>
    </envar>
    <envar>
      <name>ST_HH</name>
      <value><cyclestr>@H</cyclestr></value>
    </envar>
    <envar>
      <name>SINGLEPROC</name>
      <value>&SINGLEPROC;</value>
    </envar>

    <dependency>
      <and>
      <datadep age="120"><cyclestr>&GFS_DIR;/gfs.0p25.2015060212.f000.grib2</cyclestr></datadep>
      <datadep age="120"><cyclestr>&GFS_DIR;/gfs.0p25.2015060212.f003.grib2</cyclestr></datadep>
      <datadep age="120"><cyclestr>&GFS_DIR;/gfs.0p25.2015060212.f006.grib2</cyclestr></datadep>
      <datadep age="120"><cyclestr>&GFS_DIR;/gfs.0p25.2015060212.f009.grib2</cyclestr></datadep>
      <datadep age="120"><cyclestr>&GFS_DIR;/gfs.0p25.2015060212.f012.grib2</cyclestr></datadep>
      </and>
    </dependency>
  </task>
  <task name="GSI" maxtries="1">

    <command>&rocoto;/run_gsi.ksh</command>
    <nodes>&GSIPROC;:ppn=1</nodes>
    <queue>&QUEUE;</queue>
    <walltime>01:00:00</walltime>
    <jobname><cyclestr>GSI@Y@m@d@H</cyclestr></jobname>
    <join><cyclestr>&LOG_DIR;/gsi_@Y@m@d@H.log</cyclestr></join>

    <envar>
      <name>HOMEBASE</name>
      <value>&HOMEBASE;</value>
    </envar>
    <envar>
      <name>rocoto</name>
      <value>&rocoto;</value>
    </envar>
    <envar>
      <name>GSI_FIX</name>
      <value>&GSI_FIX;</value>
    </envar>
    <envar>
      <name>OBS_DIR</name>
      <value>&OBS_DIR;</value>
    </envar>
    <envar>
      <name>GSI_DIR</name>
      <value><cyclestr>&HOMEBASE;/@Y@m@d@H/gsi</cyclestr></value>
    </envar>
    <envar>
      <name>ANAL_TIME</name>
      <value><cyclestr>@Y@m@d@H</cyclestr></value>
    </envar>
    <envar>
      <name>ST_HH</name>
      <value><cyclestr>@H</cyclestr></value>
    </envar>
    <envar>
      <name>GSIPROC</name>
      <value>&GSIPROC;</value>
    </envar>

    <dependency>
       <taskdep task="NPS"/>
    </dependency>    

  </task>

  <task name="NMMB" maxtries="4">

    <command>&rocoto;/run_nmmb.bash</command>
    <nodes>&NMMBPROC;:ppn=1</nodes>
    <queue>&QUEUE;</queue>
    <walltime>02:00:00</walltime>
    <jobname><cyclestr>NMMB@Y@m@d@H</cyclestr></jobname>
    <join><cyclestr>&LOG_DIR;/nmmb_@Y@m@d@H.log</cyclestr></join>
    <native>-V</native>

    <envar>
      <name>HOMEBASE</name>
      <value>&HOMEBASE;</value>
    </envar>
    <envar>
      <name>rocoto</name>
      <value>&rocoto;</value>
    </envar>
    <envar>
      <name>NMMB_FIX</name>
      <value>&NMMB_FIX;</value>
    </envar>
    <envar>
      <name>boco_DIR</name>
      <value>&boco_DIR;</value>
    </envar>
    <envar>
      <name>NMMB_DIR</name>
      <value><cyclestr>&HOMEBASE;/@Y@m@d@H/nmmb</cyclestr></value>
    </envar>
    <envar>
      <name>START_TIME</name>
      <value><cyclestr>@s</cyclestr></value>
    </envar>
    <envar>
      <name>ST_md</name>
      <value><cyclestr>@m@d</cyclestr></value>
    </envar>
    <envar>
      <name>ST_YYYY</name>
      <value><cyclestr>@Y</cyclestr></value>
    </envar>
    <envar>
      <name>ST_mm</name>
      <value><cyclestr>@m</cyclestr></value>
    </envar>
    <envar>
      <name>ST_DD</name>
      <value><cyclestr>@d</cyclestr></value>
    </envar>
    <envar>
      <name>ST_HH</name>
      <value><cyclestr>@H</cyclestr></value>
    </envar>
    <envar>
      <name>ST_MM</name>
      <value><cyclestr>@M</cyclestr></value>
    </envar>
    <envar>
      <name>ST_SS</name>
      <value><cyclestr>@S</cyclestr></value>
    </envar>
    <envar>
      <name>NMMBPROC</name>
      <value>&NMMBPROC;</value>
    </envar>
    <envar>
      <name>INPES</name>
      <value>&INPES;</value>
    </envar>
    <envar>
      <name>JPES</name>
      <value>&JPES;</value>
    </envar>
    <envar>
      <name>WRITEGROUPS</name>
      <value>&WRITEGROUPS;</value>
    </envar>
    <envar>
      <name>WRITETASKS</name>
      <value>&WRITETASKS;</value>
    </envar>

    <dependency>
       <taskdep task="GSI"/>
    </dependency>

  </task>

  <metatask>
    <var name="fcst">00 03 06 09 12</var>
    <task name="UPP_#fcst#" maxtries="3">

    <command>&rocoto;/run_unipost.ksh</command>
    <nodes>&UPPPROC;:ppn=1</nodes>
    <queue>&QUEUE;</queue>
    <walltime>00:30:00</walltime>
    <jobname><cyclestr>UPP@Y@m@d@H_#fcst#</cyclestr></jobname>
    <join><cyclestr>&LOG_DIR;/upp_@Y@m@d@H_#fcst#.log</cyclestr></join>
    <native>-V</native>

    <envar>
      <name>startdate</name>
      <value><cyclestr>@Y@m@d@H</cyclestr></value>
    </envar>
    <envar>
      <name>UPPPROC</name>
      <value>&UPPPROC;</value>
    </envar>
    <envar>
      <name>fhr</name>
      <value>#fcst#</value>
    </envar>
    <envar>
      <name>lastfhr</name>
      <value>#fcst#</value>
    </envar>

    <envar>
      <name>incrementhr</name>
      <value>03</value>
    </envar>

    <dependency>
       <taskdep task="NMMB"/>
    </dependency>

  </task>
  </metatask>

</workflow>

