# common filters used later on. 
_: &land_mask
  filter: Domain Check
  where:
  - variable: {name: GeoVaLs/sea_area_fraction}
    minvalue: 0.5

cost function:
  cost type: 3D-FGAT
  time window:
    begin: &date_begin YM5-MM5-DM5T12:00:00Z
    length: P10D
  analysis variables: &soca_an_vars
  - sea_water_salinity
  - sea_water_potential_temperature
  - sea_surface_height_above_geoid
  geometry: &geom
    geom_grid_file: ./soca_gridspec.nc
    mom6_input_nml: ./input.nml
    fields metadata: ./fields_metadata.yml

  model:
    name: PseudoModel
    tstep: P1D
    _state : &state
      basename: ./forecast_mom6/
      read_from_file: 1
    states:
    - date: YM4-MM4-DM4T12:00:00Z
      ocn_filename: MOM.res.YM4MM4DM412.nc
      << : *state
    - date: YM3-MM3-DM3T12:00:00Z
      ocn_filename: MOM.res.YM3MM3DM312.nc
      << : *state
    - date: YM2-MM2-DM2T12:00:00Z
      ocn_filename: MOM.res.YM2MM2DM212.nc
      << : *state
    - date: YM1-MM1-DM1T12:00:00Z
      ocn_filename: MOM.res.YM1MM1DM112.nc
      << : *state
    - date: Y00-M00-D00T12:00:00Z
      ocn_filename: MOM.res.Y00M00D0012.nc
      << : *state
    - date: YP1-MP1-DP1T12:00:00Z
      ocn_filename: MOM.res.YP1MP1DP112.nc
      << : *state
    - date: YP2-MP2-DP2T12:00:00Z
      ocn_filename: MOM.res.YP2MP2DP212.nc
      << : *state
    - date: YP3-MP3-DP3T12:00:00Z
      ocn_filename: MOM.res.YP3MP3DP312.nc
      << : *state
    - date: YP4-MP4-DP4T12:00:00Z
      ocn_filename: MOM.res.YP4MP4DP412.nc
      << : *state
    - date: YP5-MP5-DP5T12:00:00Z
      ocn_filename: MOM.res.YP5MP5DP512.nc
      << : *state

  background:
    read_from_file: 1
    basename: ./forecast_mom6/
    ocn_filename: MOM.res.YM5MM5DM512.nc
    date: &bkg_date YM5-MM5-DM5T12:00:00Z
    state variables:
    - sea_water_salinity
    - sea_water_potential_temperature
    - sea_surface_height_above_geoid
    - sea_water_cell_thickness
    - ocean_mixed_layer_thickness
    - sea_water_depth

  background error:
    covariance model: SABER
    saber central block:
      saber block name: diffusion
      read:
        groups:
        - variables:
          - sea_water_potential_temperature
          - sea_water_salinity
          - sea_surface_height_above_geoid
          horizontal:
            filepath: ./parameters_diffusion/diffusion_cor1_hz
          vertical:
            levels: 75
            filepath: ./parameters_diffusion/diffusion_cor1_vt

    linear variable change:
      input variables: *soca_an_vars
      output variables: *soca_an_vars
      linear variable changes:

      - linear variable change name: BalanceSOCA
        kst:
          dsdtmax: 0.1
          dsdzmin: 3.0e-6
          dtdzmin: 1.0e-6
          nlayers: 10
        ksshts:
          nlayers: 10

  observations:
    observers:
    - obs space:
        name: InsituTemperature
        obsdataout:
          engine:
            type: H5File
            obsfile: data_output/prof_T_YP4MP4DP412.nc
        obsdatain:
          engine:
            type: H5File
            obsfile: obs/prof_insitu_YP4MP4DP412.nc
        simulated variables: [waterTemperature]
      obs operator:
        name: InsituTemperature
      obs error:
        covariance model: diagonal
      obs filters:
      - *land_mask
      - filter: Background Check
        threshold: 5

    - obs space:
        name: InsituSalinity
        obsdataout:
          engine:
            type: H5File
            obsfile: data_output/prof_S_YP4MP4DP412.nc
        obsdatain:
          engine:
            type: H5File
            obsfile: obs/prof_insitu_YP4MP4DP412.nc
        simulated variables: [salinity]
      obs operator:
        name: VertInterp
        observation alias file: ./obsop_name_map.yml
        vertical coordinate: sea_water_depth
        observation vertical coordinate: depth
        interpolation method: linear
      obs error:
        covariance model: diagonal
      obs filters:
      - *land_mask
      - filter: Background Check
        threshold: 5

variational:
  minimizer:
    algorithm: RPCG
  iterations:
  - geometry: *geom
    ninner: 100
    gradient norm reduction: 0.0105
minimizer:
  algorithm: RPCG

output:
  datadir: data_output/
  exp: 3dvarfgat_pseudo
  type: an

